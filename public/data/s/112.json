{"n":112,"v":[{"n":1,"a":["قُلۡ","هُوَ","ٱللَّهُ","أَحَدٌ"],"m":["Say","He","(is) Allah","the One"],"t":["qul","huwa","l-lahu","aḥadun"],"q":[[0,"Say, “He Allaah is One.”"]],"s":"Say, \"He is God, [who is] One,","c":"Say, ˹O Prophet,˺ “He is Allah—One ˹and Indivisible˺;","o":0,"j":30,"ip":["قُلۡ","هُوَ","اللّٰهُ","اَحَدٌ ۚ"],"h":"Allah’s Absolute Oneness"},{"n":2,"a":["ٱللَّهُ","ٱلصَّمَدُ"],"m":["Allah","the Eternal, the Absolute"],"t":["al-lahu","l-ṣamadu"],"q":[[0,"“Allaah is Independent.”"],[1,"(He needs no one and nothing, but everyone and everything needs Him.)"]],"s":"God, the Eternal Refuge.","c":"Allah—the Sustainer ˹needed by all˺.","o":0,"j":30,"ip":["اَللّٰهُ","الصَّمَدُ ۚ"]},{"n":3,"a":["لَمۡ","يَلِدۡ","وَلَمۡ","يُولَدۡ"],"m":["Not","He begets","and not","He is begotten"],"t":["lam","yalid","walam","yūlad"],"q":[[0,"“He has no children and is not anyone's child.”"]],"s":"He neither begets nor is born,","c":"He has never had offspring, nor was He born.","o":0,"j":30,"ip":["لَمۡ","يَلِدۡ ۙ","وَلَمۡ","يُوۡلَدۡ ۙ"]},{"n":4,"a":["وَلَمۡ","يَكُن","لَّهُۥ","كُفُوًا","أَحَدُۢ"],"m":["And not","is","for Him","equivalent","any [one]"],"t":["walam","yakun","lahu","kufuwan","aḥadun"],"q":[[0,"“There is none equal to Him"],[1,"(neither in His Being nor in His qualities).'"]],"s":"Nor is there to Him any equivalent.\"","c":"And there is none comparable to Him.”","o":0,"j":30,"ip":["وَلَمۡ","يَكُنۡ","لَّهٗ","كُفُوًا","اَحَدٌ"]}]}